{
  "name": "bayflow-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:reset": "node scripts/verify-postgres.mjs",
    "db:lint": "supabase db lint --linked --level warning --fail-on warning",
    "db:test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "db:verify:postgres": "node scripts/verify-postgres.mjs",
    "db:test:cloud": "node --test --test-concurrency=1 supabase/tests/cloud-rls.test.mjs",
    "db:test:cloud:b03": "node --test --test-concurrency=1 supabase/tests/cloud-auth.test.mjs",
    "db:test:cloud:b04": "node --test --test-concurrency=1 supabase/tests/cloud-catalog.test.mjs",
    "db:test:cloud:b05": "node --test --test-concurrency=1 supabase/tests/cloud-bookings.test.mjs",
    "db:test:cloud:b06": "node --test --test-concurrency=1 supabase/tests/cloud-actions.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:test:cloud:b07": "node --test --test-concurrency=1 supabase/tests/cloud-estimates.test.mjs",
    "db:test:cloud:b08": "node --test --test-concurrency=1 supabase/tests/cloud-parts.test.mjs",
    "db:test:cloud:b09": "node --test --test-concurrency=1 supabase/tests/cloud-repair-qc.test.mjs",
    "db:test:cloud:b10": "node --test --test-concurrency=1 supabase/tests/cloud-notifications.test.mjs",
    "db:demo:cloud": "node scripts/provision-cloud-demo.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.16.3",
    "supabase": "2.120.0",
    "typescript": "5.9.3"
  }
}
