{
  "name": "bayflow-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:reset": "node scripts/verify-postgres.mjs",
    "db:lint": "supabase db lint --linked --level warning --fail-on warning",
    "db:test": "node --test tests/*.test.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "db:verify:postgres": "node scripts/verify-postgres.mjs",
    "db:test:cloud": "node --test --test-concurrency=1 supabase/tests/cloud-rls.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.16.3",
    "supabase": "2.120.0",
    "typescript": "5.9.3"
  }
}
