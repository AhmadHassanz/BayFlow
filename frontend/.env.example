# From frontend/: Copy-Item .env.example .env.local
# Safe template only. Never commit real values or credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local development uses http://localhost:3000. Production must use the exact
# canonical HTTPS origin, without /auth/callback or a trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: required only for server-side staff account provisioning.
# Use exactly one server-only admin key; never prefix it with NEXT_PUBLIC_.
# Legacy service_role is supported. Keep unused keys empty.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
